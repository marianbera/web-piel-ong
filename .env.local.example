# Variables de entorno de la web de PIEL. Copiar a `.env.local` para desarrollo
# (está en .gitignore) y cargar las mismas en Azure App Service.
# NUNCA poner valores reales en este archivo: se versiona en Git.
# Detalle de cada una en HANDOFF.md.

# ── URL pública del sitio ────────────────────────────────────────────────────
# La URL FINAL de Azure, sin barra al final. Mercado Pago la usa para volver al
# sitio después de pagar y para mandar los avisos al webhook: si apunta a otro
# lado, las donaciones no se confirman.
# Ojo: Next.js la incrusta al compilar → tiene que estar definida en el BUILD.
NEXT_PUBLIC_SITE_URL=https://URL-FINAL-DE-AZURE

# ── Mercado Pago ─────────────────────────────────────────────────────────────
# Access Token de la aplicación de MP de la asociación (producción: APP_USR-…).
# Secreto: solo en el servidor. Sin él, Donar no muestra el formulario.
# No hace falta la Public Key: el pago se arma en el servidor.
MP_ACCESS_TOKEN=
# Clave secreta del webhook (Tus integraciones → la aplicación → Webhooks).
# Sin esto el webhook rechaza todo: es lo que prueba que la llamada viene de MP.
MP_WEBHOOK_SECRET=

# ── Base de datos de donaciones (Neon Postgres) ──────────────────────────────
# Cadena de conexión de Neon (neon.tech → el proyecto → Connection string).
# Las tablas se crean solas la primera vez. El driver es el de Neon: no sirve
# para otro Postgres sin cambiar código (ver HANDOFF.md).
DATABASE_URL=

# ── Panel de administración (/panel) ─────────────────────────────────────────
# La URL no está enlazada en ninguna parte del sitio: hay que escribirla a mano.
ADMIN_USER=
ADMIN_PASSWORD=
# Mínimo 16 caracteres. Generar con: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Almacenamiento del contenido editable del panel (equipo, premios, logos…).
# Hoy es Vercel Blob: ver la decisión pendiente en HANDOFF.md antes de cargarla.
BLOB_READ_WRITE_TOKEN=

# ── Formularios ──────────────────────────────────────────────────────────────
# Resend: formulario de contacto. Sin esto, el formulario avisa que no está configurado.
RESEND_API_KEY=
# MailerLite: suscripción al newsletter del footer.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# GOOGLE_SERVICE_ACCOUNT_EMAIL / GOOGLE_PRIVATE_KEY / GOOGLE_SPREADSHEET_ID:
# ya no se usan (lib/googleSheets.ts no se importa en ningún lado). No cargarlas.

# Resend (emails de contacto)
RESEND_API_KEY=

# MailerLite (newsletter)
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Google Sheets (donaciones)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=

# Mercado Pago (links de pago — no SDK, solo links)
MP_DONATION_LINK_INDIVIDUAL=
MP_DONATION_LINK_APADRINAMIENTO=
MP_DONATION_LINK_EMPRESA=

# App
NEXT_PUBLIC_SITE_URL=https://www.asociacion-piel.org.ar

# ── Panel de administración (/panel) ─────────────────────────────────────────
# La URL no está enlazada en ninguna parte del sitio: hay que escribirla a mano.
# Cambiar estos valores antes de publicar.
ADMIN_USER=piel
ADMIN_PASSWORD=cambiar-esta-clave
# Mínimo 16 caracteres. Generar con: openssl rand -base64 32
ADMIN_SESSION_SECRET=cambiar-por-una-cadena-larga-y-aleatoria

# Almacenamiento del contenido del panel (textos e imágenes) en Vercel Blob.
# NO hace falta escribirla a mano en Vercel: se inyecta sola al crear el Blob Store
# desde la pestaña Storage del proyecto. Solo se copia acá para desarrollo local
# (Project → Storage → el store → .env.local).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
